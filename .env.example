# ===================================================
# VisionIQ — Environment Variables Template
# ===================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:5173

# Google Gemini API (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase Auth, Database & Storage (https://supabase.com)
# Note: If left empty, VisionIQ operates in Local Development Mode with auto-seeded demo data
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage Buckets
STORAGE_BUCKET_ORIGINALS=visioniq-originals
STORAGE_BUCKET_DERIVED=visioniq-derived

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
